{
  "name": "aquasense-backend",
  "version": "1.0.0",
  "description": "AquaSense/CrayFarm API and static file server",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "cleanup:history:dry": "node scripts/cleanup-rtdb-history.js --dry-run",
    "cleanup:history": "node scripts/cleanup-rtdb-history.js",
    "cleanup:history:inspect": "node scripts/cleanup-rtdb-history.js --inspect",
    "cleanup:history:epoch": "node scripts/cleanup-rtdb-history.js --delete-keys 1970-01-01_08-00-31,1970-01-01_08-01-01",
    "seed:rtdb-day:dry": "node scripts/seed-rtdb-day.js --gap --dry-run",
    "seed:rtdb-day": "node scripts/seed-rtdb-day.js --gap",
    "seed:may-gaps:dry": "node scripts/seed-rtdb-day.js --may-gaps --dry-run",
    "seed:may-gaps": "node scripts/seed-rtdb-day.js --may-gaps",
    "cleanup:presets": "node scripts/cleanup-duplicate-presets.js",
    "update:crayfish": "node scripts/update-crayfish-preset.js"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^13.8.0"
  }
}
