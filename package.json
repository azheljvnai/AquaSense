{
  "name": "aquasense",
  "private": true,
  "version": "1.0.0",
  "description": "AquaSense/CrayFarm root scripts (runs backend)",
  "scripts": {
    "start": "npm --prefix backend start",
    "build": "echo No build step required. public/ is the frontend.",
    "dev": "npm --prefix backend run dev",
    "install:backend": "npm --prefix backend install",
    "deploy:firestore": "firebase deploy --only firestore:rules,firestore:indexes",
    "perf": "node scripts/perf/run-perf-smoke.js",
    "security": "node scripts/security/run-security-checks.js",
    "accuracy": "node scripts/accuracy/evaluate-accuracy.js",
    "feedlog:patch-device001": "node scripts/feeding/patch-feedlog-device001.js",
    "feedlog:restore-may2026": "node scripts/feeding/restore-missing-may-feedlog.js",
    "test": "vitest --run"
  },
  "dependencies": {
    "firebase": "^12.12.1"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "supertest": "^7.1.4",
    "fast-check": "^4.7.0",
    "jsdom": "^29.1.0",
    "vitest": "^4.1.5"
  }
}
